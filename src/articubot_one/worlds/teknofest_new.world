<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="teknofest_arena">

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>14 8 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>14 8 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.60 1</ambient>
            <diffuse>0.65 0.65 0.60 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer walls -->
    <model name="wall_front">
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14 0.15 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>14 0.15 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_back">
      <static>true</static>
      <pose>0 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14 0.15 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>14 0.15 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_left">
      <static>true</static>
      <pose>-7 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 8 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 8 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_right">
      <static>true</static>
      <pose>7 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 8 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 8 1.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- Middle vertical separation walls with gate opening -->
    <model name="middle_wall_top">
      <static>true</static>
      <pose>0 2.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.18 3.4 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 3.4 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="middle_wall_bottom">
      <static>true</static>
      <pose>0 -2.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.18 3.4 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.18 3.4 1.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- Gate posts -->
    <model name="gate_left_post">
      <static>true</static>
      <pose>-0.35 0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 0.35 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.35 0.9</size></box></geometry></visual>
      </link>
    </model>

    <model name="gate_right_post">
      <static>true</static>
      <pose>0.35 0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 0.35 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.35 0.9</size></box></geometry></visual>
      </link>
    </model>

    <!-- Internal left wall -->
    <model name="left_internal_wall">
      <static>true</static>
      <pose>-2.3 1.6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.6 0.15 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.6 0.15 1.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- Internal right walls -->
    <model name="right_internal_wall_top">
      <static>true</static>
      <pose>3.3 1.2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.2 0.15 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.2 0.15 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="right_internal_wall_bottom">
      <static>true</static>
      <pose>3.0 -1.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.15 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.15 1.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- Pickup pallets left side -->
    <model name="pickup_p1">
      <static>true</static>
      <pose>-5.5 2.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.3</size></box></geometry></visual>
      </link>
    </model>

    <model name="pickup_p2">
      <static>true</static>
      <pose>-4.2 2.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.3</size></box></geometry></visual>
      </link>
    </model>

    <model name="pickup_p3">
      <static>true</static>
      <pose>-2.9 2.5 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.3</size></box></geometry></visual>
      </link>
    </model>

    <!-- Drop points right side -->
    <model name="drop_d1">
      <static>true</static>
      <pose>5.8 2.3 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.3</size></box></geometry></visual>
      </link>
    </model>

    <model name="drop_d2">
      <static>true</static>
      <pose>5.8 0.0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.3</size></box></geometry></visual>
      </link>
    </model>

    <model name="drop_d3">
      <static>true</static>
      <pose>3.5 -2.4 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.45 0.45 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.45 0.45 0.3</size></box></geometry></visual>
      </link>
    </model>

    <!-- Visual dashed route lines, thin and non-collision -->
    <model name="route_center_line">
      <static>true</static>
      <pose>-2.0 0 0.035 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>6.0 0.04 0.01</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="route_to_gate">
      <static>true</static>
      <pose>1.5 0 0.035 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>3.0 0.04 0.01</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="route_right_vertical">
      <static>true</static>
      <pose>3.4 1.0 0.035 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.04 2.2 0.01</size></box></geometry>
          <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>